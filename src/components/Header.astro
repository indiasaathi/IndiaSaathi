---
import { site } from '../data/site';
---

<header class="header">
  <div class="header-top">
    <div class="logo-block">
      <div class="logo-name">INDIA SAATHI</div>
      <div class="logo-tag">
        {site.tagline} · {site.location}
      </div>
    </div>
    <div class="header-badge">NRI India Desk</div>
  </div>
  <h1 class="header-headline">
    End-to-End Asset, Property &amp; Financial Services for NRIs — From Anywhere in the World
  </h1>
  <p class="header-sub">
    Whether you need to sell property, close legacy assets, manage ongoing affairs, or repatriate
    funds — India Saathi is your single trusted point of contact in Mumbai, handling everything
    professionally and transparently while you stay abroad.
  </p>
  <div class="gold-bar"></div>
</header>
