---
import Icon from './Icon.astro';
import { whyUs } from '../data/services';
---

<section class="why-section" aria-labelledby="why-heading">
  <h2 class="section-label" id="why-heading">
    Why NRIs Choose India Saathi
  </h2>
  <div class="why-grid">
    {whyUs.map(({ icon, label }) => (
      <div class="why-item">
        <div class="why-icon">
          <Icon name={icon} />
        </div>
        <div class="why-label">{label}</div>
      </div>
    ))}
  </div>
</section>
